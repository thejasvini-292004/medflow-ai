# =========================================================================
# MedFlow AI — environment configuration
# Copy this file to `.env` and fill in what you need. Everything has a
# sensible default so the project also boots with NO keys (offline mode).
# =========================================================================

# ---- LLM provider ----
# The agent talks to any OpenAI-compatible chat endpoint.
# For OpenAI:      LLM_BASE_URL is left blank, set OPENAI_API_KEY.
# For a local LLM: point LLM_BASE_URL at e.g. http://localhost:11434/v1 (Ollama)
#                  and set OPENAI_API_KEY to any non-empty placeholder.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0

# ---- Embeddings ----
# EMBEDDINGS_PROVIDER = openai | hf | hashing
#   openai  -> uses OPENAI_API_KEY + EMBEDDINGS_MODEL
#   hf      -> local sentence-transformers (requires optional deps)
#   hashing -> deterministic, dependency-free, NO network. Great for CI/offline.
EMBEDDINGS_PROVIDER=hashing
EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Paths ----
DB_PATH=data/medflow.db
CHROMA_DIR=data/chroma

# ---- External signal tool ----
# Latitude/longitude used by the weather/public-health signal tool.
# Defaults to Los Angeles (the hospital's location in this scenario).
SIGNAL_LAT=34.0522
SIGNAL_LON=-118.2437
# Set to "false" to force the deterministic offline fallback (no network calls).
SIGNAL_USE_LIVE_API=true

# ---- Observability (optional) ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=medflow-ai
